{
  "name": "dsh-wsl-overlay",
  "version": "0.1.0",
  "description": "Transparent WSL takeover for DSH: agent file tools, bash and search run inside a WSL distro when the session workspace is a \\\\wsl.localhost UNC path. Zero private registry; preset variants of the profile's own presets.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./fs": "./lib/fs.js",
    "./shell": "./lib/shell.js",
    "./search": "./lib/search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "agent",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "windows",
    "cordis"
  ],
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-patch": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-shell": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-patch": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "dev:links": "node scripts/dev-links.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfys/dsh-wsl-overlay.git"
  }
}
